        "JIANYING_DRAFT_CRYPTO": "<JY_DRAFTC_EXECUTABLE>",
        "JIANYING_FFMPEG": "<FFMPEG_EXECUTABLE>",
        "JIANYING_FFPROBE": "<FFPROBE_EXECUTABLE>"
      }
    }
  }
}
